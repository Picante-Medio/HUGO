particle_system Particle/SmokeBomb
{
    material        UI/Knob
    particle_width  75
    particle_height 75
    cull_each       true
    quota           300
    billboard_type  point
    sorted          true

    emitter Point
    {
        position 0 15 -15
        angle 180
        colour 0.5 0.5 0.5 0.4
        emission_rate 45
        time_to_live_min 1
        time_to_live_max 3
        direction 0 1 0
        velocity_min 10
        velocity_max 20
        duration 0
    }

    affector Rotator
    {
        rotation_range_start 0
        rotation_range_end 360
        rotation_speed_range_start -30
        rotation_speed_range_end 30
    }

    affector Scaler
    {
        rate 2
    }
}
