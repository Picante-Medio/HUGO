material prueba/ColorVerde
{
    technique 
	{
		pass 
		{
			ambient 0.3 1.0 0.3
			diffuse 0.3 1.0 0.3
			specular 0.3 0.3 0.3 8
		}
    }
}

material prueba/ColorRosa
{
    technique 
	{
		pass 
		{
			ambient 1.0 0.4 0.7
			diffuse 1.0 0.4 0.7
			specular 0.3 0.3 0.3 8
		}
    }
}
material prueba/Textura
{
	technique
	{
		pass
		{
            texture_unit{
                texture spaceSky.jpg
            }
		}
	}
}

// material forOverlays
material UI/Red
{
    technique
    {
        pass
        {
            // MUST BE INCLUDED
            lighting off
            depth_check off
            depth_write off
            scene_blend alpha_blend
            
            ambient 1.0 0.0 0.0
            diffuse 1.0 0.0 0.0 1.0
            emissive 1.0 0.0 0.0

			texture_unit{
                colour_op replace
            }
        }
    }
}