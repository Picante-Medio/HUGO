overlay testCanvas/SimpleTest1
{
    zorder 10

    overlay_element testCanvas/SimpleTest1/Container Panel
    {
        // Center it horizontally, put it at the top
        left 0.1
        top 0.2
        width 0.3
        height 0.1
        //material UI/Red
    }
}

overlay testCanvas/SimpleTest
{
    zorder 500

    overlay_element testCanvas/SimpleTest/Container Panel
    {
        left 0.5
        top 0.2
        width 0.3
        height 0.1

        overlay_element testCanvas/SimpleTest/Container/Text TextArea
        {
            font_name Roboto 
            char_height 0.04 
            caption Animo chiquis
            space_width 0.025
            colour_top 1.0 0.0 1.0 1.0
            colour_bottom 0.0 1.0 1.0 1.0
        }
    }
}