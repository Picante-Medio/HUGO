overlay Console/InputText
{
    zorder 500

    overlay_element Console/InputText/Container Panel
    {
        overlay_element Console/InputText/Container/Text TextArea
        {
            left 0.1
            top 0.2
            font_name Roboto 
            char_height 0.04 
            space_width 0.025
            horz_align left 
            vert_align center  
        }
    }
}

overlay Console/LogText
{
    zorder 500

    overlay_element Console/LogText/Container Panel
    {
        overlay_element Console/LogText/Container/Text TextArea
        {
            left 0.1
            top 0.2
            font_name Roboto 
            space_width 0.025
            horz_align left 
            vert_align top  
        }
    }
}

overlay Console/InfoText
{
    zorder 10

    overlay_element Console/InfoText/Container Panel
    {
        overlay_element Console/InfoText/Container/Text TextArea
        {
            left 0.1
            top 0.2
            font_name Roboto 
            space_width 0.025
            horz_align left 
            vert_align center   
        }
    }
}