particle_system Particle/Smoke
{
    billboard_type      point
    particle_width      5
    particle_height     5
    quota               300
    sorted              true

    emitter Point {
        position 0 0 0
        direction 0 1 0
        angle 160 
        duration 0
        emission_rate 60  
        time_to_live_min 1.5
        time_to_live_max 3.0

        velocity_min 5
        velocity_max 20
    }

    affector Scaler {
        rate 15
    }

    affector ColourFader {
        red   -0.05
        green -0.05
        blue  -0.05
        alpha -0.2
    }
}