material prueba/Textura
{
	technique
	{
		pass
		{
            texture_unit{
                texture spaceSky.jpg
            }
		}
	}
}

material debug/DefaultMaterial
{
	technique 
	{
		pass{
			ambient 1.00 1.00 1.00 1.00
			diffuse 1.00 1.00 1.00 1.00
			specular 0.6 0.6 0.6 8
		}
	}
}

material Square/Pedro
{
	technique 
	{
		pass{
			 texture_unit{
                texture pedro.png
				scale 0.25 0.25
				rotate 270
				scroll 0 -0.5
            }
		}
	}
}

material Square/Pablo
{
	technique 
	{
		pass{
			texture_unit{
                texture pablo.png
				scale 0.25 0.25
				rotate 270
				scroll 0 -0.5
            }
		}
	}
}

material debug/WireframeMaterial
{
	technique 
	{
		pass{

			polygon_mode wireframe

			ambient 1.00 1.00 1.00 1.00
			diffuse 1.00 1.00 1.00 1.00
			specular 0.6 0.6 0.6 8
		}
	}
}

material debug/Smoke
{
    technique {
        pass {
            lighting off
            scene_blend alpha_blend
            depth_write off   
            diffuse vertexcolour
            texture_unit {
                texture hugu.png
                tex_address_mode clamp
            }
        }
    }   
}