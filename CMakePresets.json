{
    "version": 8,
    "configurePresets": [
        {
            "name": "VS_17_2022_x64",
            "displayName": "VS 17 2022 x64",
            "description": "Using compilers for Visual Studio 17 2022 (x64 architecture)",
            "generator": "Visual Studio 17 2022",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_CXX_FLAGS_DEBUG": "/Od /Zi",
                "CMAKE_CXX_FLAGS_RELEASE": "/O2",
                "OGRE_BUILD_MSVC_MP": "ON",
                "OGRE_BUILD_MSVC_ZM": "ON"
            }
        },
        {
            "name": "LINUX_GCC_x64",
            "displayName": "Linux GCC x64",
            "description": "Using GCC for Linux x64 architecture",
            "generator": "Unix Makefiles",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3",
                "OGRE_BUILD_MSVC_MP": "OFF",
                "OGRE_BUILD_MSVC_ZM": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "DEBUG_VS_17_2022_x64",
            "displayName": "DEBUG VS 17 2022 x64",
            "configurePreset": "VS_17_2022_x64",
            "configuration": "Debug",
            "jobs": 8
        },
        {
            "name": "RELEASE_VS_17_2022_x64",
            "displayName": "RELEASE VS 17 2022 x64",
            "configurePreset": "VS_17_2022_x64",
            "configuration": "Release",
            "jobs": 8
        },
        {
            "name": "DEBUG_LINUX_GCC_x64",
            "displayName": "DEBUG Linux GCC x64",
            "configurePreset": "LINUX_GCC_x64",
            "configuration": "Debug",
            "jobs": 8
        },
        {
            "name": "RELEASE_LINUX_GCC_x64",
            "displayName": "RELEASE Linux GCC x64",
            "configurePreset": "LINUX_GCC_x64",
            "configuration": "Release",
            "jobs": 8
        }
    ]
}